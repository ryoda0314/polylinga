# Supabase (shared with the old poly-lang project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for scripts/migrate.mjs on your machine; never set this on the hosting provider
SUPABASE_DB_URL=
# IPv4 fallback for scripts/migrate.mjs when the machine has no IPv6 route (Connect → Session pooler host)
SUPABASE_POOLER_HOST=

# OpenAI: corrections and example search
OPENAI_API_KEY=

# Vertex AI: Gemini text-to-speech
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_KEY=

# Comma-separated addresses allowed into /admin
ADMIN_EMAILS=

# Optional: corrections per learner per day (default 20)
PL_USER_CORRECTIONS_PER_DAY=

# Optional: whole-service daily ceilings (defaults 1000 corrections, 3000 new audio clips)
PL_GLOBAL_CORRECTIONS_PER_DAY=
PL_GLOBAL_TTS_PER_DAY=

# The public address (metadata, and the links in sign-up and password mails), e.g. https://polylinga.vercel.app
NEXT_PUBLIC_APP_URL=

# Sign-up and password mails, sent by the app through Resend (same account as the old app)
RESEND_API_KEY=
# Optional: sender (default ことのあめ <no-reply@polylinga.app>) and the whole-service ceiling (default 80 a day)
EMAIL_FROM=
PL_GLOBAL_EMAILS_PER_DAY=

# ことのあめ's own Google OAuth client (Web). Empty: the shared redirect sign-in is used
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
