  "patterns": [
    {
      "id": "ja-naii",
      "lang": "ja",
      "form": "〜ない？",
      "examples": "行く → 行かない？ · 食べる → 食べない？",
      "meaning": {
        "ja": "「〜しない？」と気軽に誘う言い方",
        "en": "\"Why don't we ~?\" — a casual invitation",
        "ko": "'~하지 않을래?'처럼 가볍게 권하는 말",
        "zh": "“要不要～？”，随意的邀请"
      },
      "function_id": "invite"
    },
    {
      "id": "en-wanna",
      "lang": "en",
      "form": "Wanna + V?",
      "examples": "go → Wanna go? · eat → Wanna grab something to eat?",
      "meaning": {
        "ja": "「〜しない？」と気軽に誘う言い方（want to のくだけた形）",
        "en": "A casual invitation (spoken form of \"want to\")",
        "ko": "가볍게 권하는 말 (want to의 구어체)",
        "zh": "随意的邀请（want to 的口语形式）"
      },
      "function_id": "invite"
    },
    {
      "id": "ko-eullae",
      "lang": "ko",
      "form": "V + (으)ㄹ래?",
      "examples": "가다 → 갈래 · 먹다 → 먹을래 · 보다 → 볼래",
      "meaning": {
        "ja": "「〜する？」と気軽に誘う言い方。パッチムがなければ ㄹ래、あれば 을래",
        "en": "\"Wanna ~?\" — a casual invitation. ㄹ래 after a vowel, 을래 after a final consonant",
        "ko": "가볍게 권하거나 의향을 묻는 말",
        "zh": "随意地邀请或询问对方意向。无收音用 ㄹ래，有收音用 을래"
      },
      "function_id": "invite"
    },
    {
      "id": "zh-yaobuyao",
      "lang": "zh",
      "form": "要不要 + V？",
      "examples": "去 → 要不要去？ · 吃饭 → 要不要一起吃饭？",
      "meaning": {
        "ja": "「〜する？」と気軽に誘う言い方",
        "en": "\"Do you want to ~?\" — a casual invitation",
        "ko": "'~할래?'처럼 가볍게 권하는 말",
        "zh": "随意地邀请对方"
      },
      "function_id": "invite"
    },
    {
      "id": "ja-tai",
      "lang": "ja",
      "form": "V + たい",
      "examples": "行く → 行きたい · 食べる → 食べたい",
      "meaning": {
        "ja": "「〜したい」自分の希望を言う",
        "en": "\"I want to ~\" — saying what you want to do",
        "ko": "'~하고 싶다' 자신의 바람을 말하기",
        "zh": "“想～”，表达自己的愿望"
      },
      "function_id": "want"
    },
    {
      "id": "en-want-to",
      "lang": "en",
      "form": "I want to + V",
      "examples": "go → I want to go · eat → I want to eat",
      "meaning": {
        "ja": "「〜したい」自分の希望を言う",
        "en": "Saying what you want to do",
        "ko": "'~하고 싶어' 자신의 바람을 말하기",
        "zh": "表达自己想做的事"
      },
      "function_id": "want"
    },
    {
      "id": "ko-go-sipeo",
      "lang": "ko",
      "form": "V + 고 싶어",
      "examples": "가다 → 가고 싶어 · 먹다 → 먹고 싶어",
      "meaning": {
        "ja": "「〜したい」。動詞の語幹に 고 싶어 を付ける",
        "en": "\"I want to ~\" — add 고 싶어 to the verb stem",
        "ko": "자신의 바람을 말하기",
        "zh": "“想～”，在动词词干后加 고 싶어"
      },
      "function_id": "want"
    },
    {
      "id": "zh-xiang",
      "lang": "zh",
      "form": "想 + V",
      "examples": "去 → 想去 · 吃 → 想吃",
      "meaning": {
        "ja": "「〜したい」。動詞の前に 想 を置く",
        "en": "\"want to ~\" — put 想 before the verb",
        "ko": "'~하고 싶다'. 동사 앞에 想을 붙인다",
        "zh": "表达愿望"
      },
      "function_id": "want"
    },
    {
      "id": "ja-kanou",
      "lang": "ja",
      "form": "〜られる／〜える",
      "examples": "来る → 来られる · 行く → 行ける · 撮る → 撮れる",
      "meaning": {
        "ja": "「〜できる」できるかどうかを言う・聞く",
        "en": "\"can ~\" — the potential form of a verb",
        "ko": "'~할 수 있다' 가능을 나타내는 형태",
        "zh": "“能～”，动词的可能形"
      },
      "function_id": "can"
    },
    {
      "id": "en-can",
      "lang": "en",
      "form": "Can you / I + V?",
      "examples": "come → Can you come? · take → Can I take photos?",
      "meaning": {
        "ja": "「〜できる？」できるかどうかを聞く",
        "en": "Asking whether something is possible",
        "ko": "'~할 수 있어?' 가능한지 묻기",
        "zh": "询问能不能做某事"
      },
      "function_id": "can"
    },
    {
      "id": "ko-su-isseo",
      "lang": "ko",
      "form": "V + (으)ㄹ 수 있어",
      "examples": "오다 → 올 수 있어 · 찍다 → 찍을 수 있어",
      "meaning": {
        "ja": "「〜できる」。パッチムがなければ ㄹ 수 있어、あれば 을 수 있어",
        "en": "\"can ~\" — ㄹ 수 있어 after a vowel, 을 수 있어 after a final consonant",
        "ko": "가능을 나타내는 말",
        "zh": "“能～”。无收音用 ㄹ 수 있어，有收音用 을 수 있어"
      },
      "function_id": "can"
    },
    {
      "id": "zh-neng",
      "lang": "zh",
      "form": "能 + V",
      "examples": "来 → 能来吗？ · 拍照 → 能拍照吗？",
      "meaning": {
        "ja": "「〜できる」。動詞の前に 能 を置く。質問するときは文末に 吗",
        "en": "\"can ~\" — put 能 before the verb; add 吗 to ask",
        "ko": "'~할 수 있다'. 동사 앞에 能, 질문은 끝에 吗",
        "zh": "表示能力或可能"
      },
      "function_id": "can"
    },
    {
      "id": "ja-tekureru",
      "lang": "ja",
      "form": "〜てくれる？",
      "examples": "待つ → 待ってくれる？ · 言う → 言ってくれる？",
      "meaning": {
        "ja": "「〜してくれる？」気軽にお願いする",
        "en": "\"Could you ~ (for me)?\" — a casual request",
        "ko": "'~해 줄래?' 가볍게 부탁하기",
        "zh": "“可以帮我～吗？”，随意地请求"
      },
      "function_id": "request"
    },
    {
      "id": "en-could-you",
      "lang": "en",
      "form": "Could you + V?",
      "examples": "wait → Could you wait? · say → Could you say that again?",
      "meaning": {
        "ja": "「〜してくれる？」ていねいめのお願い",
        "en": "A polite request",
        "ko": "'~해 줄래요?' 정중하게 부탁하기",
        "zh": "礼貌地请求"
      },
      "function_id": "request"
    },
    {
      "id": "ko-a-jullae",
      "lang": "ko",
      "form": "V + 아/어 줄래?",
      "examples": "기다리다 → 기다려 줄래? · 찍다 → 찍어 줄래?",
      "meaning": {
        "ja": "「〜してくれる？」。動詞の 아/어 形に 줄래? を付ける",
        "en": "\"Could you ~ for me?\" — the 아/어 form of a verb + 줄래?",
        "ko": "가볍게 부탁하기",
        "zh": "“可以帮我～吗？”。动词的 아/어 形 + 줄래?"
      },
      "function_id": "request"
    },
    {
      "id": "zh-keyi",
      "lang": "zh",
      "form": "可以 + V + 吗？",
      "examples": "等 → 可以等我一下吗？ · 说 → 可以再说一遍吗？",
      "meaning": {
        "ja": "「〜してもらえる？」。可以 … 吗？でお願いする",
        "en": "\"Could you ~?\" — ask with 可以 … 吗？",
        "ko": "'~해 줄 수 있어?'. 可以 … 吗？로 부탁하기",
        "zh": "礼貌地请求"
      },
      "function_id": "request"
    },
    {
      "id": "ja-takotoaru",
      "lang": "ja",
      "form": "〜たことある？",
      "examples": "行く → 行ったことある？ · 見る → 見たことある？",
      "meaning": {
        "ja": "「〜したことある？」経験を聞く",
        "en": "\"Have you ever ~?\" — asking about experience",
        "ko": "'~한 적 있어?' 경험 묻기",
        "zh": "“～过吗？”，询问经历"
      },
      "function_id": "experience"
    },
    {
      "id": "en-have-you-ever",
      "lang": "en",
      "form": "Have you ever + past participle?",
      "examples": "be → Have you ever been to …? · see → Have you ever seen …?",
      "meaning": {
        "ja": "「〜したことある？」経験を聞く",
        "en": "Asking about experience",
        "ko": "'~해 본 적 있어?' 경험 묻기",
        "zh": "询问经历"
      },
      "function_id": "experience"
    },
    {
      "id": "ko-jeok-isseo",
      "lang": "ko",
      "form": "V-(으)ㄴ 적 있어?",
      "examples": "가 보다 → 가 본 적 있어? · 만들어 보다 → 만들어 본 적 있어? · 보다 → 본 적 있어?",
      "meaning": {
        "ja": "「〜したことある？」。動詞の (으)ㄴ 形に 적 있어? を付けて経験を聞く。「〜してみたことある？」は 아/어 본 적 있어?",
        "en": "\"Have you ever ~?\" — the (으)ㄴ form of a verb + 적 있어?. \"Have you ever tried ~?\" is 아/어 본 적 있어?",
        "ko": "경험 묻기. '~해 본 적 있어?'는 해 본 경험을 물을 때",
        "zh": "“～过吗？”。动词的 (으)ㄴ 形 + 적 있어?。“试过～吗？”用 아/어 본 적 있어?"
      },
      "function_id": "experience"
    },
    {
      "id": "zh-guo",
      "lang": "zh",
      "form": "V + 过",
      "examples": "去 → 去过 · 看 → 看过",
      "meaning": {
        "ja": "「〜したことがある」。動詞のあとに 过",
